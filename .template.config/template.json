{
  "$schema": "http://json.schemastore.org/template",
  "author": "Azure Functions",
  "classifications": [ "Functions", "Azure", "CSharp" ],
  "identity": "Azure.Functions.Templates.CSharpAzdQuickstart",
  "name": "Functions Quickstart (C# + AZD)",
  "shortName": "functions-quickstart-dotnet-azd",
  "sources": [
    {
      "modifiers": [
        {
          "description": "Exclude .git folder",
          "exclude": [ ".git/**" ]
        }
      ]
    }
  ],
  "symbols": {
    "skipRestore": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": false,
      "description": "If specified, skips the automatic restore of the project on create."
    }
  },
  "specialCustomOperations": {
    "**/*.bicep": {
      "flagPrefix": "//",
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "style": "line",
            "token": "//",
            "evaluator": "C++",
            "wholeLine": true,
            "trimWhitespace": true
          }
        }
      ]
    }
  },
  "postActions": [
    {
      "id": "restore",
      "condition": "(!skipRestore)",
      "description": "Restore NuGet packages required by this project.",
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore'"
        }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}
